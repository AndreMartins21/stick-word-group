# Cópia deste arquivo: `cp .env.example .env` e preencha com valores FALSOS para
# desenvolvimento local. O `.env` real nunca é versionado (ver .gitignore).
# Em produção o arquivo é renderizado na VM a partir do Secret Manager (infra/deploy.sh).

# ---- Aplicação ------------------------------------------------------------
APP_ENV=local                      # local | prod
LOG_LEVEL=INFO

# ---- Usuário / canal ------------------------------------------------------
ALLOWED_NUMBER=5531999998888       # número pessoal do usuário (o dono), só dígitos
# ALLOWED_NUMBERS=5511988887777,5521977776666   # opcional (M14): mais alunos, separados por vírgula
# ALLOWED_GROUPS=                                # opcional (M14): ids @g.us autorizados
# OWNER_NUMBER=                                  # opcional (M14): padrão = ALLOWED_NUMBER
# MAX_GROUPS=10                                  # opcional (M15): teto de grupos ativados por admin
# CONTACT_EMAIL=smartins.bot@gmail.com           # opcional (M15): contato mostrado a quem não tem plano
# GROUP_PREFIX=!                                 # opcional (M16): prefixo dos comandos no grupo
# MAX_CARACTERES=500                             # opcional (M40): teto de caracteres por mensagem
# MAX_SEGUNDOS_AUDIO=60                          # opcional (M41): duração máxima da nota de voz
# LIMITE_PESSOA_MINUTO=6  LIMITE_PESSOA_DIA=150  LIMITE_GRUPO_DIA=400  LIMITE_AUDIO_SEGUNDOS_DIA=600  # opcionais (M43)
# LIMITE_POR_SESSAO_GRUPO=5                      # opcional (M17): palavras por rodada em grupo
# TIMEOUT_MARCACAO_HORAS=3                       # opcional (M17): espera pela pessoa marcada
BOT_NUMBER=5531988887777           # número Vivo do bot, só dígitos (informativo)
USER_LEVEL=B1-B2                   # A1-A2 | A2-B1 | B1-B2 | B2-C1 | C1-C2 | C2
TIMEZONE=America/Sao_Paulo         # fuso do aluno, para distribuir os lembretes (seção 5.7)

# ---- WAHA (gateway WhatsApp) ---------------------------------------------
WAHA_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=fake-local-key        # em prod vem do Secret Manager
WAHA_DASHBOARD_PASSWORD=fake-local # em prod vem do Secret Manager
# Assinatura HMAC dos webhooks (opcional; em prod vem do Secret Manager):
WAHA_HOOK_HMAC_KEY=

# ---- IA -------------------------------------------------------------------
LLM_PROVIDER=vertex_gemini         # vertex_gemini (padrão) | anthropic
GCP_PROJECT_ID=meu-projeto-local
VERTEX_LOCATION=global
# Modelo Gemini (GA, fora da família 2.5, que será aposentada em outubro/2026).
# GEMINI_MODEL_EVAL (opcional) é um modelo maior só para avaliar frases.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_EVAL=
# GEMINI_MODEL_AUDIO (opcional, M39) transcreve notas de voz; vazio usa o GEMINI_MODEL.
GEMINI_MODEL_AUDIO=
# Só com LLM_PROVIDER=anthropic (em prod vem do Secret Manager):
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Storage --------------------------------------------------------------
EXPORT_BUCKET=meu-projeto-vocabot-exports
# Pronúncia em áudio (M23): só em produção; vazio = a opção "Hear how it sounds" avisa que falhou
AUDIO_BUCKET=
TTS_VOICE=en-US-Neural2-F
# Snapshot diário de métricas (M28, ADR-0029): só em produção; vazio = o snapshot fica desligado
METRICS_BUCKET=

# ---- Letras de música (/song, M13) -----------------------------------------
LYRICS_URL=https://lrclib.net      # API pública do LRCLIB, sem chave (ADR-0016)
